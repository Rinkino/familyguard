# Mapbox public token (starts with pk.) from account.mapbox.com
# Used for directions, and for search when no Geoapify key is set.
# Leave empty to use sample Lagos places.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Geoapify API key from myprojects.geoapify.com. Place search across Nigeria
# (schools, markets, malls) on OpenStreetMap data. Optional but recommended.
EXPO_PUBLIC_GEOAPIFY_KEY=

# Supabase project. Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
