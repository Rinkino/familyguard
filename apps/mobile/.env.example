# Mapbox public token (starts with pk.) from account.mapbox.com
# Used for search, dropped-pin addresses and directions.
# Leave empty to use sample Lagos places.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Supabase project (sign-in only). Project Settings > API.
# Leave empty to use simulated sign-in.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
